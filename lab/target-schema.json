{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/radeon-kernels/target-v1.schema.json",
  "title": "Radeon Kernels private target configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "targets"],
  "properties": {
    "schema_version": { "const": 1 },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/target" }
    }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ssh_host", "remote_root", "gpu_ids", "container"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "ssh_host": { "type": "string", "minLength": 1 },
        "expected_architecture": {
          "oneOf": [
            { "const": "auto" },
            { "type": "string", "pattern": "^gfx[0-9a-f]+$" }
          ],
          "default": "auto"
        },
        "remote_root": { "type": "string", "pattern": "^/(?!$).+" },
        "gpu_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0 }
        },
        "gpus_per_job": { "type": "integer", "minimum": 1, "default": 1 },
        "max_parallel_jobs": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "busy_policy": {
          "enum": ["wait", "skip", "fail"],
          "default": "wait"
        },
        "busy_timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "default": 1800
        },
        "container": { "$ref": "#/$defs/container" }
      }
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "image", "workdir"],
      "properties": {
        "runtime": { "enum": ["docker", "podman"] },
        "image": {
          "type": "string",
          "pattern": "^[^\\s@]+@sha256:[0-9a-fA-F]{64}$"
        },
        "workdir": { "type": "string", "pattern": "^/" },
        "devices": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 },
          "default": []
        },
        "security_options": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 },
          "default": []
        },
        "mounts": {
          "type": "array",
          "items": { "$ref": "#/$defs/mount" },
          "default": []
        },
        "environment_from_host": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z_][A-Z0-9_]*$"
          },
          "default": []
        }
      }
    },
    "mount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "pattern": "^/" },
        "read_only": { "type": "boolean", "default": true }
      }
    }
  }
}
