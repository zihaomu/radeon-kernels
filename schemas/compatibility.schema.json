{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://radeon-kernels.dev/schemas/compatibility.schema.json",
  "title": "Radeon Kernels compatibility database",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "records"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "architecture", "wavefront_size", "rocm_abi", "python_abi", "pytorch_version", "provider", "status", "evidence_id", "approval_id", "reason"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
          "architecture": {"type": "string", "pattern": "^gfx[0-9a-f]+$"},
          "wavefront_size": {"enum": [32, 64]},
          "rocm_abi": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
          "python_abi": {"type": "string", "pattern": "^cp[0-9]{2,3}$"},
          "pytorch_version": {"type": "string", "minLength": 1},
          "provider": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
          "provider_version": {"type": "string", "minLength": 1},
          "features": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "status": {"enum": ["supported", "unsupported", "known_bad", "experimental"]},
          "evidence_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
          "approval_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
