{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://radeon-kernels.dev/schemas/dispatch.schema.json",
  "title": "Radeon Kernels dispatch manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operator", "semantic_version", "default_fallbacks", "entries"],
  "properties": {
    "schema_version": {"$ref": "#/$defs/version"},
    "operator": {"$ref": "#/$defs/identifier"},
    "semantic_version": {"$ref": "#/$defs/version"},
    "default_fallbacks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "entries": {
      "type": "array",
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["architecture", "wavefront_size", "rocm_abi", "python_abi", "pytorch_version"],
      "properties": {
        "architecture": {"type": "string", "pattern": "^gfx[0-9a-f]+$"},
        "wavefront_size": {"enum": [32, 64]},
        "rocm_abi": {"$ref": "#/$defs/version"},
        "python_abi": {"type": "string", "pattern": "^cp[0-9]{2,3}$"},
        "pytorch_version": {"type": "string", "minLength": 1},
        "features": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z0-9_]+$"}
        }
      }
    },
    "constraint": {
      "oneOf": [
        {"type": ["string", "number", "integer", "boolean"]},
        {
          "type": "array",
          "prefixItems": [
            {"type": "integer", "minimum": 1},
            {"type": "integer", "minimum": 1}
          ],
          "minItems": 2,
          "maxItems": 2
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["one_of"],
          "properties": {
            "one_of": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": ["string", "number", "integer", "boolean"]}
            }
          }
        }
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "artifact", "entrypoint", "sha256"],
      "properties": {
        "provider": {"$ref": "#/$defs/identifier"},
        "artifact": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "entrypoint": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "format": {"enum": ["python_extension", "hsaco"]}
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "priority", "environment", "workload", "winner", "launch", "fallbacks", "evidence_id"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "priority": {"type": "integer", "minimum": 0},
        "environment": {"$ref": "#/$defs/environment"},
        "workload": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"pattern": "^[a-z][a-z0-9_.-]*$"},
          "additionalProperties": {"$ref": "#/$defs/constraint"}
        },
        "winner": {"$ref": "#/$defs/artifact"},
        "launch": {
          "type": "object",
          "propertyNames": {"pattern": "^[a-z][a-z0-9_.-]*$"},
          "additionalProperties": {"type": ["string", "number", "integer", "boolean"]}
        },
        "fallbacks": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "evidence_id": {"$ref": "#/$defs/identifier"}
      }
    }
  }
}
