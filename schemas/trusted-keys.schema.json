{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://radeon-kernels.dev/schemas/trusted-keys.schema.json",
  "title": "Radeon Kernels trusted release keys",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "keys"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key_id", "algorithm", "public_key", "status", "created_at"],
        "properties": {
          "key_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
          "algorithm": {"const": "ed25519"},
          "public_key": {"type": "string", "minLength": 43, "maxLength": 44},
          "status": {"enum": ["active", "revoked"]},
          "created_at": {"type": "string", "format": "date-time"},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
