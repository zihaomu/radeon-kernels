{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://radeon-kernels.dev/schemas/kernel-pack.schema.json",
  "title": "Radeon Kernels precompiled kernel pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pack_id", "pack_version", "environment", "artifacts"],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "pack_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
    "pack_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["architecture", "wavefront_size", "rocm_abi", "python_abi", "pytorch_version"],
      "properties": {
        "architecture": {"type": "string", "pattern": "^gfx[0-9a-f]+$"},
        "wavefront_size": {"enum": [32, 64]},
        "rocm_abi": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
        "python_abi": {"type": "string", "pattern": "^cp[0-9]{2,3}$"},
        "pytorch_version": {"type": "string", "minLength": 1}
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operator", "semantic_version", "provider", "artifact", "entrypoint", "sha256", "format", "evidence_id"],
        "properties": {
          "operator": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
          "semantic_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
          "provider": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
          "artifact": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
          "entrypoint": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "format": {"enum": ["python_extension", "hsaco"]},
          "evidence_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"}
        }
      }
    }
  }
}
