{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://radeon-kernels.dev/schemas/operator-contract.schema.json",
  "title": "Radeon Kernels operator contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operator",
    "semantic_version",
    "inputs",
    "outputs",
    "capabilities",
    "numerics",
    "reference"
  ],
  "properties": {
    "schema_version": {"$ref": "#/$defs/version"},
    "operator": {"$ref": "#/$defs/identifier"},
    "semantic_version": {"$ref": "#/$defs/version"},
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/tensor"}
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/tensor"}
    },
    "parameters": {
      "type": "object",
      "additionalProperties": {"type": ["string", "number", "integer", "boolean"]}
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inference", "backward", "deterministic", "graph_capture"],
      "properties": {
        "inference": {"type": "boolean"},
        "backward": {"type": "boolean"},
        "deterministic": {"type": "boolean"},
        "graph_capture": {"type": "boolean"}
      }
    },
    "numerics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accumulation_dtype", "absolute_tolerance", "relative_tolerance", "non_finite_policy"],
      "properties": {
        "accumulation_dtype": {"type": "string", "minLength": 1},
        "absolute_tolerance": {"type": "number", "minimum": 0},
        "relative_tolerance": {"type": "number", "minimum": 0},
        "non_finite_policy": {"enum": ["reject", "propagate", "contract_defined"]}
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "entrypoint"],
      "properties": {
        "provider": {"$ref": "#/$defs/identifier"},
        "entrypoint": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "tensor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "dtypes", "rank", "layouts", "alias"],
      "properties": {
        "name": {"$ref": "#/$defs/identifier"},
        "dtypes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "rank": {"type": "integer", "minimum": 0},
        "layouts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "alias": {"enum": ["none", "input", "output"]}
      }
    }
  }
}
